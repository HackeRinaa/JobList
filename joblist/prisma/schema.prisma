generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String?
  stripeCustomerId String?
  authId           String?
  role             UserRole      @default(CUSTOMER)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tokens           Int           @default(0)
  applications     Application[] @relation("WorkerApplications")
  assignedJobs     JobListing[]  @relation("AssignedWorker")
  createdListings  JobListing[]  @relation("CustomerListings")
  messages         Message[]
  profile          Profile?
  reviewsReceived  Review[]      @relation("ReviewsReceived")
  reviewsGiven     Review[]      @relation("ReviewsGiven")
  subscription     Subscription?
  tokenPurchases   TokenPurchase[]
}

model Profile {
  id            String       @id @default(cuid())
  userId        String       @unique
  bio           String?
  profession    String?
  location      String?
  rating        Float?
  completedJobs Int         @default(0)
  phone         String?
  city          String?
  postalCode    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  preferences   JobCategory[] @default([])
  imageUrl      String?
  user          User         @relation(fields: [userId], references: [id])
}

enum JobCategory {
  ELECTRICIAN
  PLUMBER
  PAINTER
  CARPENTER
  HVAC_TECHNICIAN
  APPLIANCE_REPAIR
  GENERAL_CONTRACTOR
  ARCHITECT
  INTERIOR_DESIGNER
  LANDSCAPER
  MASON
  ROOFER
  FLOORING_SPECIALIST
  SECURITY_SYSTEM_INSTALLER
  HOME_INSPECTOR
  CLEANING_SERVICE
  PEST_CONTROL
  POOL_MAINTENANCE
  SOLAR_INSTALLER
  SMART_HOME_TECHNICIAN
}

model JobListing {
  id               String        @id @default(cuid())
  title            String
  category         JobCategory
  location         String
  description      String
  budget           String
  customerId       String
  assignedWorkerId String?
  status           JobStatus     @default(PENDING)
  premium          Boolean       @default(false)
  tokenCost        Int          @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  applications     Application[]
  customer         User          @relation("CustomerListings", fields: [customerId], references: [id])
  assignedWorker   User?         @relation("AssignedWorker", fields: [assignedWorkerId], references: [id])
}

model Application {
  id             String             @id @default(cuid())
  jobId          String
  workerId       String
  message        String?
  estimatedPrice String?
  status         ApplicationStatus  @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  job            JobListing        @relation(fields: [jobId], references: [id])
  worker         User              @relation("WorkerApplications", fields: [workerId], references: [id])
  messages       Message[]
}

model Message {
  id            String      @id @default(cuid())
  content       String
  senderId      String
  applicationId String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id])
  sender        User        @relation(fields: [senderId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  jobId      String
  reviewerId String
  reviewedId String
  createdAt  DateTime @default(now())
  reviewed   User     @relation("ReviewsReceived", fields: [reviewedId], references: [id])
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
}

model AdminStats {
  id                   String   @id @default(cuid())
  totalUsers           Int      @default(0)
  activeCustomers      Int      @default(0)
  activeWorkers        Int      @default(0)
  adminUsers           Int      @default(0)
  totalJobs            Int      @default(0)
  pendingJobs          Int      @default(0)
  completedJobs        Int      @default(0)
  canceledJobs         Int      @default(0)
  totalApplications    Int      @default(0)
  acceptedApplications Int      @default(0)
  newUsersToday       Int      @default(0)
  newJobsToday        Int      @default(0)
  revenue             Float    @default(0)
  lastUpdated         DateTime @default(now())
}

model Subscription {
  id                  String            @id @default(cuid())
  userId              String            @unique
  stripeSubscriptionId String
  status              SubscriptionStatus
  plan                SubscriptionPlan
  endDate             DateTime?
  startDate           DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id])
}

model TokenPurchase {
  id              String           @id @default(cuid())
  userId          String
  amount          Int
  cost            Float
  stripePaymentId String
  status          PurchaseStatus
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id])
}

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN
}

enum JobStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum SubscriptionPlan {
  BASIC
  PRO
  PREMIUM
}

enum PurchaseStatus {
  COMPLETED
  PENDING
  FAILED
}
